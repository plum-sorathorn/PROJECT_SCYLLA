Makefile
compile_commands.json
.cmake/

# ── Python ───────────────────────────────────────────────────
backend/.venv/
**/__pycache__/
**/*.py[cod]
**/*.pyo
**/*.pyd
*.egg-info/
dist/
build/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
coverage.xml

# ── Environment & secrets ─────────────────────────────────────
.env
.env.*
*.env
secrets.json
config.local.*

# ── Temp files written by the launcher ───────────────────────
scylla_odp_launch.bat
scylla_cpp_launch.bat

# ── Logs ─────────────────────────────────────────────────────
*.log
logs/
*.log.*

# ── OS files ─────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/

